@startuml
node "SimraApp" {
  component "CSV Util Service" as CSVUtil
  component "Ride Incident Service" as RideIncident
  component "Valhalla Trace Attributes Service" as ValhallaTrace
  component "Ride Entity" as RideEntity
  component "Planet Osm Line" as PlanetOsmLine
}

node "Valhalla Server" as ValhallaServer
database "PostGIS" as DB
file "rideCsvFiles" as CSVFile

CSVFile --> CSVUtil : Read CSV (location & incident data)
CSVUtil --> RideIncident : Provide parsed data
RideIncident --> ValhallaTrace : Request osm_id (via REST mapping)
ValhallaTrace --> ValhallaServer : Query trace attributes
ValhallaServer --> ValhallaTrace : Return osm_id
RideIncident --> RideEntity : embed PlanetOsmLine into
RideEntity --> DB : Save new ride entity with connected PlanetOsmLine (Street)

RideEntity <--> PlanetOsmLine
@enduml
