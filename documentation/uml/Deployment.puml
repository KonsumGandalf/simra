@startuml
skinparam componentStyle rectangle
@startuml
skinparam componentStyle rectangle
skinparam shadowing true
skinparam defaultTextAlignment center

actor "User" as User

node "Docker Host" {

  node "NGINX Container" {
    [Angular Frontend] as Angular
  }

  node "Redis Cache" as Redis
  node "Spring Backend Container" {
    [Spring Boot Application] as Backend
  }

  database "PostGIS Database" as DB

  node "Valhalla Routing Server" as Valhalla

  file "Rides CSV\n(Fahrtdaten)" as RidesCSV
  file "Profile CSV\n(Nutzerprofile)" as ProfileCSV
}

User --> Angular : HTTPS Request
Angular --> Backend : REST API Call
Backend --> DB : SQL Query
Backend --> RidesCSV : CSV Read
Backend --> ProfileCSV : CSV Read
Backend --> Valhalla : Send GPS Track
Valhalla --> Backend : Return matched OSM Segments
Backend --> Redis : Check for cached responses


@enduml
